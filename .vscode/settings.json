{
	"php.validate.executablePath": "php",
	"php.validate.run": "onType",
	"phpcs.enable": true,
	"phpcs.standard": "./phpcs.xml",
	"phpcs.executablePath": "./vendor/bin/phpcs.bat",
	"editor.defaultFormatter": "esbenp.prettier-vscode",
	"editor.formatOnSave": true,
	"editor.codeActionsOnSave": {
		"source.fixAll.eslint": "explicit",
		"source.fixAll.stylelint": "explicit",
		"source.fixAll.phpcs": "explicit"
	},
	"files.associations": {
		"*.php": "php",
		"*.js": "javascript",
		"*.css": "css"
	},
	"search.exclude": {
		"**/vendor/**": true,
		"**/node_modules/**": true,
		"**/dist/**": true
	},
	"emmet.includeLanguages": {
		"php": "html"
	},
	"intelephense.diagnostics.enable": false,
	"php.validate.enable": false
	// AI rules pointer for agents and helper tasks
	,"ai.rulesPath": ".vscode/ai-rules.md",
	"ai.complianceTemplatePath": ".vscode/compliance-check-template.md",

	// Best-effort Copilot Chat / GitHub Copilot system prompt settings (workspace-level)
	// These keys may be picked up by Copilot Chat; if not, use the 'AI: Copy workspace rules to clipboard' task.
	"github.copilot-chat.systemPrompts": {
		"workspaceRules": {
			"title": "Workspace AI Rules (shahi-legalflowsuite)",
			"bodyPath": ".vscode/ai-rules.md",
			"description": "Rules that must be prepended as a System message before any prompt."
		}
	},
	"github.copilot.chat.systemPrompts": {
		"workspaceRules": {
			"title": "Workspace AI Rules (shahi-legalflowsuite)",
			"bodyPath": ".vscode/ai-rules.md",
			"description": "Rules that must be prepended as a System message before any prompt."
		}
	}
}
