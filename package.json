{
	"name": "shahi-legalflowsuite",
	"version": "3.5.0",
	"description": "WordPress plugin for legal operations management",
	"scripts": {
		"lint": "eslint assets/js/**/*.js && stylelint assets/css/**/*.css",
		"lint:fix": "eslint assets/js/**/*.js --fix && stylelint assets/css/**/*.css --fix",
		"format": "prettier --write assets/js/**/*.js assets/css/**/*.css",
		"phpcs": "phpcs",
		"phpcbf": "phpcbf",
		"test": "phpunit"
	},
	"devDependencies": {
		"@wordpress/eslint-plugin": "^14.0.0",
		"eslint": "^8.0.0",
		"husky": "^8.0.0",
		"lint-staged": "^13.0.0",
		"prettier": "^3.0.0",
		"eslint-plugin-prettier": "^5.0.0",
		"eslint-config-prettier": "^9.0.0",
		"stylelint": "^15.0.0",
		"stylelint-config-standard": "^34.0.0"
	},
	"husky": {
		"hooks": {
			"pre-commit": "lint-staged"
		}
	},
	"lint-staged": {
		"*.js": [
			"eslint --fix",
			"prettier --write"
		],
		"*.css": [
			"stylelint --fix",
			"prettier --write"
		],
		"*.php": [
			"phpcs --standard=phpcs.xml"
		]
	}
}
