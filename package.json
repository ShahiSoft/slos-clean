{
	"name": "shahi-legalflowsuite",
	"version": "3.5.0",
	"private": true,
	"description": "Build tooling for Shahi LegalFlowSuite WordPress plugin",
	"scripts": {
		"dev": "webpack --mode development --watch",
		"build": "npm run generate-pot && node ./scripts/copy-to-dist.js && node ./scripts/pack-dist.js",
		"generate-pot": "php wp-cli.phar i18n make-pot . languages/shahi-legalflowsuite.pot --domain=shahi-legalflowsuite --exclude=dist,node_modules,release",
		"clean-dist": "node ./scripts/clean-dist.js",
		"lint": "eslint assets/js/**/*.js && stylelint assets/css/**/*.css",
		"lint:fix": "eslint assets/js/**/*.js --fix && stylelint assets/css/**/*.css --fix",
		"format": "prettier --write assets/js/**/*.js assets/css/**/*.css",
		"phpcs": "phpcs",
		"phpcbf": "phpcbf",
		"test": "phpunit"
	},
	"devDependencies": {
		"@babel/core": "^7.22.0",
		"@babel/preset-env": "^7.22.0",
		"@wordpress/eslint-plugin": "^14.0.0",
		"archiver": "^5.3.0",
		"babel-loader": "^9.1.2",
		"clean-webpack-plugin": "^4.0.0",
		"copy-webpack-plugin": "^11.0.0",
		"css-loader": "^6.8.1",
		"css-minimizer-webpack-plugin": "^5.0.1",
		"eslint": "^8.0.0",
		"eslint-config-prettier": "^8.8.0",
		"eslint-plugin-prettier": "^4.2.1",
		"fs-extra": "^11.1.1",
		"husky": "^8.0.0",
		"lint-staged": "^13.0.0",
		"mini-css-extract-plugin": "^2.7.6",
		"postcss": "^8.4.29",
		"postcss-loader": "^7.3.3",
		"autoprefixer": "^10.4.14",
		"prettier": "^2.8.8",
		"sass": "^1.70.0",
		"sass-loader": "^13.2.2",
		"stylelint": "^15.0.0",
		"stylelint-config-standard": "^34.0.0",
		"terser-webpack-plugin": "^5.3.6",
		"webpack": "^5.88.2",
		"webpack-cli": "^5.1.4"
	},
	"husky": {
		"hooks": {
			"pre-commit": "lint-staged"
		}
	},
	"lint-staged": {
		"*.js": [
			"eslint --fix",
			"prettier --write"
		],
		"*.css": [
			"stylelint --fix",
			"prettier --write"
		],
		"*.php": [
			"phpcs --standard=phpcs.xml"
		]
	}
}
